# ============================================
# CRM Lead Management System - Environment Config
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=crm_lead_management

# JWT Secret (change this in production)
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h
